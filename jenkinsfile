pipeline{
    agent{
        docker {
            image 'balaji510/jenkins-agent:slim'
            args '--user root -v /var/run/docker.sock:/var/run/docker.sock'
        }
    }
    environment{
        ECR_REPO_URI = '331867785866.dkr.ecr.us-east-1.amazonaws.com/docker_images' //URI of the REPO
        ECR_REPO_NAME = 'docker_images'
        AWS_ACCESS_KEY_ID = credentials('aws-cred') 
        AWS_SECRET_ACCESS_KEY = credentials('aws-cred') 
        AWS_REGION = 'us-east-1' 
    }
    stages{
        stage('Checkout'){
            steps{
                sh 'echo passed'
                git branch: 'main', url: 'https://github.com/balaji-510/Final-CI-CD.git'
            }
        }
        stage('Running'){
            steps{
                sh'''
                    cd shared
                    mvn clean install
                    cd ..
                    mvn clean package -DskipTests
                    echo parts_done....
                '''
            }
        }
        stage('Services'){
            steps{ 
                sh'''
                    docker build -t order-service:latest ./order-service/.
                    docker build -t payment-service:latest ./payment-service/.
                    docker build -t stock-service:latest ./stock-service/.
                '''
            }
        }
        stage('Tagging Images'){
            steps{
                sh'''
                    docker tag order-service:latest $ECR_REPO_URI:order-service
                    docker tag payment-service:latest $ECR_REPO_URI:payment-service
                    docker tag stock-service:latest $ECR_REPO_URI:stock-service
                '''
            }
        }
        stage('PUSHING IMAGE TO ECR') {
            //login to AWS ECR and push the image
            steps {
                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                    credentialsId: 'aws-cred']
                ]) {        
                    sh '''
                    aws --version
                    echo Login_Done...
                    aws ecr get-login-password --region us-east-1 | docker login --username AWS --password-stdin 331867785866.dkr.ecr.us-east-1.amazonaws.com
                    echo Pass_set...
                    docker push $ECR_REPO_URI:order-service
                    docker push $ECR_REPO_URI:payment-service
                    docker push $ECR_REPO_URI:stock-service
                    echo done...
                    '''
                }
            }
        }
    }
}