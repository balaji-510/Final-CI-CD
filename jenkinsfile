pipeline{
    agent{
        docker {
            image 'balaji510/jenkins-agent:1.0'
            args '--user root -v /var/run/docker.sock:/var/run/docker.sock'
        }
    }
    stages{
        stage('Checkout'){
            steps{
                sh 'echo passed'
                git branch: 'main', url: 'https://github.com/balaji-510/Final-CI-CD.git'
            }
        }
        /*stage('Build'){
            steps{
                sh 'docker compose up -d'
            }
        }*/
        stage('Running'){
            steps{
                sh'''
                    cd shared
                    mvn clean install
                    cd ..
                    mvn clean package -DskipTests
                    cd order-service
                    mvn clean package -DskipTests
                    cd ..
                    cd payment-service
                    mvn clean package -DskipTests
                    cd ..
                    cd stock-service
                    mvn clean package -DskipTests
                    cd ..
                    echo parts_done....
                '''
            }
        }
        stage('Services'){
            steps{ 
                sh'''
                    docker build -t order-service:1.0 ./order-service/.
                    docker build -t payment-service:1.0 ./payment-service/.
                    docker build -t stock-service:1.0 ./stock-service/.
                '''
            }
        }
    }
}