pipeline {
    agent {
        docker {
            image 'balaji510/jenkins-agent:1.0'
            // IMPORTANT: do NOT run as root
            args '-v /var/run/docker.sock:/var/run/docker.sock'
        }
    }

    options {
        cleanWs()   // fixes permission issues permanently
    }

    stages {

        stage('Checkout') {
            steps {
                git branch: 'main',
                    url: 'https://github.com/balaji-510/Final-CI-CD.git'
            }
        }

        stage('Build Maven Artifacts') {
            steps {
                sh '''
                  set -e
                  mvn clean package -DskipTests
                '''
            }
        }

        stage('Verify Artifacts') {
            steps {
                sh '''
                  ls -lh */target/*.jar
                '''
            }
        }

        stage('Build Docker Images') {
            steps {
                sh '''
                  docker build -t order-service:1.0 order-service
                  docker build -t payment-service:1.0 payment-service
                  docker build -t stock-service:1.0 stock-service
                '''
            }
        }
        stage('Push Images') {
            steps {
                sh '''
                  docker push balaji510/order-service:1.0
                  docker push balaji510/payment-service:1.0
                  docker push balaji510/stock-service:1.0
                '''
            }
        }
        
    }
}
